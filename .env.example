# ── Faza environment variables ─────────────────────────────────────────────
# Copy to .env.local and fill in real values. Never commit .env.local.

# WalletConnect Project ID (required for wallet modal)
# Get a free one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Deployed FazaBoard contract address on Arc Mainnet
# Run: bash scripts/deploy-fazaboard.sh
# Then paste the printed address here.
NEXT_PUBLIC_FAZABOARD_ADDRESS=

# Arc Mainnet RPC (optional override — defaults to public RPC)
# ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
